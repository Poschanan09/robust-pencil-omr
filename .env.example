# Application Settings
APP_NAME="Robust Pencil OMR System"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Storage Settings
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=20

# Pipeline Default Thresholds
OMR_T_LOW=0.15
OMR_T_HIGH=0.40
OMR_DELTA_MIN=0.20
OMR_USE_MORPHOLOGY=True

# Kaggle API Credentials (Optional, if using Kaggle CLI)
# KAGGLE_USERNAME="your_username"
# KAGGLE_KEY="your_api_key"
